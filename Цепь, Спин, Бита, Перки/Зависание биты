// K-stick toggle with Russian UI
// Supports both Latin and Cyrillic keyboards

// Enhanced key detection for multiple keyboard layouts
function isKKey(event) {
    const key = event.key.toLowerCase();
    const code = event.code.toLowerCase();
    
    // Latin K
    if (key === 'k' || code === 'keyk') return true;
    
    // Cyrillic Л (appears as 'k' position on Russian keyboard)
    if (key === 'л' || code === 'keyk') return true;
    
    // Handle different keyboard layouts
    if (event.code === 'KeyK') return true;
    
    return false;
}

function isLKey(event) {
    const key = event.key.toLowerCase();
    const code = event.code.toLowerCase();
    
    // Latin L
    if (key === 'l' || code === 'keyl') return true;
    
    // Cyrillic Д (appears as 'l' position on Russian keyboard)
    if (key === 'д' || code === 'keyl') return true;
    
    // Handle different keyboard layouts
    if (event.code === 'KeyL') return true;
    
    return false;
}

// Create UI overlay
const ui = document.createElement('div');
ui.style.cssText = `
    position: fixed; top: 20px; right: 20px; z-index: 10000;
    background: rgba(0,0,0,0.8); color: white; padding: 15px;
    border-radius: 8px; font-family: monospace; font-size: 14px;
    border: 2px solid #444; backdrop-filter: blur(10px);
    min-width: 180px; user-select: none;
`;

const toggle = document.createElement('label');
toggle.style.cssText = `
    display: flex; align-items: center; gap: 10px; cursor: pointer;
`;

const checkbox = document.createElement('input');
checkbox.type = 'checkbox';
checkbox.style.cssText = `
    width: 40px; height: 20px; appearance: none; background: #333;
    border-radius: 20px; position: relative; cursor: pointer;
    transition: 0.3s; border: 2px solid #555;
`;

const style = document.createElement('style');
style.textContent = `
    input[type="checkbox"]:checked { background: #4CAF50 !important; }
    input[type="checkbox"]::before {
        content: ''; position: absolute; width: 16px; height: 16px;
        border-radius: 50%; background: white; top: 0px; left: 0px;
        transition: 0.3s; transform: translateX(0px);
    }
    input[type="checkbox"]:checked::before { transform: translateX(18px); }
`;
document.head.appendChild(style);

const label = document.createElement('span');
label.textContent = 'K Клавиша: ВЫКЛ';
toggle.appendChild(checkbox);
toggle.appendChild(label);
ui.appendChild(toggle);
document.body.appendChild(ui);

// Toggle functionality
let kStuck = false;
let preventKKeyUp = null;

function toggleKStick() {
    if (!kStuck) {
        preventKKeyUp = function(event) {
            if (isKKey(event)) {
                event.preventDefault();
                event.stopPropagation();
            }
        };
        document.addEventListener('keyup', preventKKeyUp, true);
        kStuck = true;
        label.textContent = 'K Клавиша: ЗАБЛОК';
        label.style.color = '#ff4444';
        checkbox.checked = true;
    } else {
        if (preventKKeyUp) {
            document.removeEventListener('keyup', preventKKeyUp, true);
            preventKKeyUp = null;
        }
        kStuck = false;
        label.textContent = 'K Клавиша: ВЫКЛ';
        label.style.color = 'white';
        checkbox.checked = false;
    }
}

checkbox.addEventListener('change', toggleKStick);

// L/Д key still works for toggle
document.addEventListener('keydown', function(e) {
    if (isLKey(e) && !e.ctrlKey && !e.altKey && !e.metaKey) {
        if (!['INPUT', 'TEXTAREA'].includes(e.target.tagName)) {
            e.preventDefault();
            toggleKStick();
        }
    }
});

console.log('✅ K-блокировщик загружен! Нажмите L/Д или используйте переключатель справа вверху.');
