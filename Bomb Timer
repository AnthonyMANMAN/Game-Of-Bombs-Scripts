// ==UserScript==
// @name         GOB Atlas Swap
// @match        *://gameofbombs.com/*
// @run-at       document-start
// @description    idk
// @version       0.1
// ==/UserScript==

var replacement = "https://raw.githubusercontent.com/AnthonyMANMAN/Scripts/refs/heads/main/bomb_64x64_2%20(1).png";

var desc = Object.getOwnPropertyDescriptor(HTMLImageElement.prototype, 'src');

Object.defineProperty(HTMLImageElement.prototype, 'src', {
    set: function(val) {
        if (val && val.includes("bomb_64x64_2.png")) {
            desc.set.call(this, replacement);
        } else {
            desc.set.call(this, val);
        }
    },
    get: function() {
        return desc.get.call(this);
    }
});

