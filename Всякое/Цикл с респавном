    // ─── RESPAWN LOGIC ───────────────────────────────────────────────
    function tryRespawn() {
        return new Promise((resolve) => {
            const btn = document.querySelector('button[ng-click="commandSpace()"]');
            if (btn) {
                btn.click();
                console.log('✅ Respawned via В бой button');
                resolve(true);
                return;
            }

            console.log('⚠️ В бой button not found, trying Space key...');
            let attempts = 0;
            const interval = setInterval(() => {
                const btn = document.querySelector('button[ng-click="commandSpace()"]');
                if (btn) {
                    btn.click();
                    console.log('✅ Respawned via В бой button (retry)');
                    clearInterval(interval);
                    resolve(true);
                    return;
                }

                // Simulate spacebar press as fallback
                const spaceEvent = new KeyboardEvent('keydown', {
                    key: ' ',
                    code: 'Space',
                    keyCode: 32,
                    which: 32,
                    bubbles: true
                });
                document.dispatchEvent(spaceEvent);
                console.log(`⌨️ Space key pressed (attempt ${attempts + 1})`);

                attempts++;
                if (attempts >= 5) {
                    clearInterval(interval);
                    console.log('❌ Could not respawn after 5 attempts');
                    resolve(false);
                }
            }, 1000);
        });
    }
